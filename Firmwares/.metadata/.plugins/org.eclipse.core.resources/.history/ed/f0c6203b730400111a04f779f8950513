/* USER CODE BEGIN 4 */

void HAL_CAN_RxFifo0MsgPendingCallback(CAN_HandleTypeDef *hcan)
{
  CAN_RxHeaderTypeDef RxHeader;
  uint8_t RxData[8];
  CAN_Msg_t msg_to_store;

  // 1. Get data from hardware
  if (HAL_CAN_GetRxMessage(hcan, CAN_RX_FIFO0, &RxHeader, RxData) == HAL_OK)
  {
      // 2. Pack into our custom struct
      msg_to_store.StdId = RxHeader.StdId; // NOTE: Use StdId, not ID
      memcpy(msg_to_store.Data, RxData, 8);

      // 3. Send to Queue (Timeout MUST be 0 in an ISR)
      osMessageQueuePut(CANRxQueueHandle, &msg_to_store, 0U, 0U);
  }
}

