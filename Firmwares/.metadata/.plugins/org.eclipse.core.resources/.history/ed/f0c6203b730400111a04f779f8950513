{
  GPIO_PinState pin_state = (state == 1) ? GPIO_PIN_SET : GPIO_PIN_RESET;
  HAL_GPIO_WritePin(GPIOA, GPIO_PIN_8 | GPIO_PIN_9, pin_state);
  HAL_GPIO_WritePin(GPIOB, GPIO_PIN_4 | GPIO_PIN_10, pin_state);
}

